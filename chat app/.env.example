# Environment Configuration for LiveChat
SECRET_KEY=livechat-super-secure-production-secret-key-2026
DATABASE_URL=sqlite:///chat.db
# Redis connection URL (e.g., redis://127.0.0.1:6379/0 or redis://:password@host:6379/0)
REDIS_URL=redis://127.0.0.1:6379/0
# Set to 'true' to require Redis connection on startup, or 'false' for graceful local fallback mode
REQUIRE_REDIS=false
PORT=5000
FLASK_DEBUG=false
